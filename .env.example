# Primary Indic Speech Gateway (Sarvam AI)
SARVAM_API_KEY=

# Translation & Medical Terminology (Cloud Translation Advanced v3)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_PROJECT_ID=
GOOGLE_GLOSSARY_ID=

# GroqCloud (Ultra-low latency LLM clinical extraction & Whisper speech)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database & Cache Persistence (optional for production scale)
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
REDIS_URL=redis://localhost:6379/0

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
